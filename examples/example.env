# Public example values only. Replace all values before use.
# This file must never contain credentials, private keys, peer IDs, or tokens.

# USB Ethernet gadget LAN
TRAVEL_USB_INTERFACE=usb0
TRAVEL_USB_SUBNET=192.0.2.0/24
TRAVEL_USB_GATEWAY=192.0.2.1
TRAVEL_USB_DHCP_RANGE=192.0.2.100,192.0.2.150,12h

# Untrusted upstream Wi-Fi transport
TRAVEL_UPSTREAM_INTERFACE=wlan0
TRAVEL_UPSTREAM_CONNECTION=travel-upstream

# NetBird and home control relay
TRAVEL_NETBIRD_SERVICE=netbird
TRAVEL_RELAY_HOST=home-relay.example.invalid
TRAVEL_RELAY_PORT=2222
TRAVEL_RELAY_USER=travel-router
TRAVEL_RELAY_IDENTITY=/etc/travel-router/relay_ed25519

# Local services and non-secret runtime state
TRAVEL_STATUS_SERVICE=travel-router-status.service
TRAVEL_DISPLAY_SERVICE=travel-router-display.service
TRAVEL_STATUS_CACHE=/run/travel-router/status.json
TRAVEL_APPLICATION_DIR=/opt/travel-router

# Hardware display and controls
TRAVEL_EPAPER_BACKEND=waveshare_epd.epd2in7
TRAVEL_GPIO_K1=5
TRAVEL_GPIO_K2=6
TRAVEL_GPIO_K3=13
TRAVEL_GPIO_K4=19
